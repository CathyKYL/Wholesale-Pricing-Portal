# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to '.env' for local development
# For cloud deployment, set these as environment variables in your platform
#
# IMPORTANT: Never commit the actual .env file to git!
# =============================================================================

# ---------- ENVIRONMENT ----------
# Options: development, staging, production
ENVIRONMENT=development

# ---------- DATABASE ----------
# Local PostgreSQL (for development):
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/wholesale_portal

# Cloud PostgreSQL examples:
# Railway: Automatically provided as DATABASE_URL
# Render: Automatically provided as DATABASE_URL  
# Supabase: Get from project settings → Database → Connection String
# Heroku: Automatically provided as DATABASE_URL
# AWS RDS: postgresql://user:password@your-instance.rds.amazonaws.com:5432/dbname

# ---------- API KEYS ----------
# Keepa API Key (get from https://keepa.com/#!api)
KEEPA_API_KEY=your_keepa_api_key_here

# ---------- FILE PATHS ----------
# Excel file path (relative to project root for local, or cloud storage URL)
# Local example:
EXCEL_PATH=Data.xlsx

# Cloud example (if using cloud storage):
# EXCEL_PATH=https://your-bucket.s3.amazonaws.com/data.xlsx

# ---------- CORS CONFIGURATION ----------
# Comma-separated list of allowed frontend URLs
# Local development (React/Vue/Angular dev servers):
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Production (add your Netlify/Vercel domain):
# CORS_ORIGINS=https://your-app.netlify.app,http://localhost:3000

# Or for production only:
# FRONTEND_URL=https://your-app.netlify.app

# ---------- SECURITY ----------
# Secret key for JWT tokens and encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_in_production

# ---------- LOGGING ----------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# DEPLOYMENT QUICK REFERENCE
# =============================================================================
#
# LOCAL DEVELOPMENT:
# 1. Copy this file to .env
# 2. Update DATABASE_URL with your local PostgreSQL credentials
# 3. Add your KEEPA_API_KEY
# 4. Run: python backend/app/smoke_test.py
#
# CLOUD DEPLOYMENT (Railway example):
# 1. Create new project on Railway
# 2. Add PostgreSQL database (DATABASE_URL auto-provided)
# 3. Set environment variables in Railway dashboard:
#    - KEEPA_API_KEY
#    - ENVIRONMENT=production
#    - FRONTEND_URL=https://your-app.netlify.app
#    - SECRET_KEY (generate new one!)
# 4. Deploy backend
#
# NETLIFY FRONTEND:
# 1. Build static frontend
# 2. Set API_URL environment variable to your Railway backend URL
# 3. Deploy to Netlify
#
# =============================================================================

